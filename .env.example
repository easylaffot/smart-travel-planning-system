APP_NAME=Smart Travel Planning System
APP_ENV=development
LOG_LEVEL=INFO

# Ollama Cloud
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=

# External providers (configured in Phase 2)
SEARCH_API_KEY=
WEATHER_API_KEY=
ROUTING_API_KEY=
HOTEL_API_KEY=
TRANSPORT_API_KEY=

# Safe prototype defaults
USE_MOCK_HOTELS=true
USE_MOCK_TRANSPORT=true
MAX_TRIP_DAYS=30
MAX_REVISION_ROUNDS=2
REQUEST_TIMEOUT_SECONDS=20
